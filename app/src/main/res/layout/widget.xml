<?xml version="1.0" encoding="utf-8"?>
<!-- Plain fixed rows, no StackView/collection: One UI leaves reapplied collection cards blank (sg-pm25-widget lesson).
     Widgets.build hides what a size can't fit. -->
<!-- Background is its own ImageView so Setup's colour + transparency can tint it (setColorFilter / setImageAlpha)
     while keeping the rounded corners; RemoteViews can't recolour a shape background directly. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/widget_bg" android:scaleType="fitXY" android:importantForAccessibility="no" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="6dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/stop" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:textColor="#212121" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/dist" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#616161" android:maxLines="1" android:paddingStart="6dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="3dp" android:gravity="center_vertical">
        <TextView android:id="@+id/no0" android:includeFontPadding="false" android:layout_width="52dp" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#1B5E20" android:maxLines="1" />
        <TextView android:id="@+id/e0a" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#212121" android:maxLines="1" />
        <TextView android:id="@+id/e0b" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#424242" android:maxLines="1" />
        <TextView android:id="@+id/e0c" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#424242" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="3dp" android:gravity="center_vertical">
        <TextView android:id="@+id/no1" android:includeFontPadding="false" android:layout_width="52dp" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#1B5E20" android:maxLines="1" />
        <TextView android:id="@+id/e1a" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#212121" android:maxLines="1" />
        <TextView android:id="@+id/e1b" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#424242" android:maxLines="1" />
        <TextView android:id="@+id/e1c" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#424242" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="3dp" android:gravity="center_vertical">
        <TextView android:id="@+id/no2" android:includeFontPadding="false" android:layout_width="52dp" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#1B5E20" android:maxLines="1" />
        <TextView android:id="@+id/e2a" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#212121" android:maxLines="1" />
        <TextView android:id="@+id/e2b" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#424242" android:maxLines="1" />
        <TextView android:id="@+id/e2c" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#424242" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="3dp" android:gravity="center_vertical">
        <TextView android:id="@+id/no3" android:includeFontPadding="false" android:layout_width="52dp" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#1B5E20" android:maxLines="1" />
        <TextView android:id="@+id/e3a" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#212121" android:maxLines="1" />
        <TextView android:id="@+id/e3b" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#424242" android:maxLines="1" />
        <TextView android:id="@+id/e3c" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#424242" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="3dp" android:gravity="center_vertical">
        <TextView android:id="@+id/no4" android:includeFontPadding="false" android:layout_width="52dp" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#1B5E20" android:maxLines="1" />
        <TextView android:id="@+id/e4a" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#212121" android:maxLines="1" />
        <TextView android:id="@+id/e4b" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#424242" android:maxLines="1" />
        <TextView android:id="@+id/e4c" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#424242" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="3dp" android:gravity="center_vertical">
        <TextView android:id="@+id/no5" android:includeFontPadding="false" android:layout_width="52dp" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#1B5E20" android:maxLines="1" />
        <TextView android:id="@+id/e5a" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#212121" android:maxLines="1" />
        <TextView android:id="@+id/e5b" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#424242" android:maxLines="1" />
        <TextView android:id="@+id/e5c" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#424242" android:maxLines="1" />
    </LinearLayout>

    <TextView android:id="@+id/stop2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp" android:textSize="12sp" android:textStyle="bold" android:textColor="#424242"
        android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    <TextView android:id="@+id/line2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="#424242" android:maxLines="2" android:visibility="gone" />

    <!-- spacer: plain View is not allowed in RemoteViews -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="#757575" android:maxLines="1" android:ellipsize="end"
        android:text="Tap for live bus times" />
</LinearLayout>
</FrameLayout>
